# ConceptIQ Environment Configuration

# Provider: 'gemini', 'openai', or 'fallback' (deterministic offline mode)
LLM_PROVIDER=gemini

# Google Gemini API Key (Gemini 2.5 Flash / 1.5 Flash)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (GPT-4o Mini)
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration (SQLite with WAL mode by default)
DATABASE_URL=sqlite:///./conceptiq.db

